// Zulfira dynamic platform — Postgres schema (Neon).
// Money is ALWAYS Decimal(12,2). Never float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum ExpenseCategory {
  RAW_MATERIAL
  PACKAGING
  DELIVERY
  MARKETING
  SALARY
  UTILITIES
  OTHER
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  WASTE
}

enum AdminRole {
  OWNER
  STAFF
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  sku           String?  @unique
  tagline       String?
  size          String?
  salePrice     Decimal  @db.Decimal(12, 2)
  compareAt     Decimal? @db.Decimal(12, 2)
  unitCost      Decimal  @default(0) @db.Decimal(12, 2)
  stockQty      Int      @default(0)
  lowStockLevel Int      @default(10)
  image         String?
  gallery       String[] @default([])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  investors   ProductInvestor[]
  investments Investment[]
  expenses    Expense[]
  orderItems  OrderItem[]
  movements   StockMovement[]
  reviews     Review[]
}

model Investor {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  productLinks ProductInvestor[]
  investments  Investment[]
}

// Profit-share agreement: one row per (product, investor).
// profitSharePct across all investors of a product MUST total 100.
model ProductInvestor {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  investorId    String
  investor      Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  profitSharePct Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@unique([productId, investorId])
  @@index([productId])
}

// Money put in, per tranche (history preserved).
model Investment {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  investedAt DateTime @default(now())
  notes      String?

  @@index([productId])
  @@index([investorId])
}

// productId = null  =>  general expense (allocated across products by revenue share).
model Expense {
  id        String          @id @default(cuid())
  category  ExpenseCategory
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  amount    Decimal         @db.Decimal(12, 2)
  date      DateTime        @default(now())
  note      String?
  receiptUrl String?
  createdBy String?
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([category])
  @@index([date])
}

model Order {
  id             String        @id @default(cuid())
  orderNo        String        @unique
  customerName   String
  phone          String
  address        String
  city           String
  notes          String?
  status         OrderStatus   @default(PENDING)
  statusReason   String?
  payment        PaymentMethod @default(COD)
  subtotal       Decimal       @db.Decimal(12, 2)
  deliveryCharge Decimal       @default(0) @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deliveredAt    DateTime?
  courierName    String?
  trackingNumber String?

  items OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([phone])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty       Int
  unitPrice Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  qty       Int // positive = stock in, negative = stock out
  note      String?
  orderId   String?
  createdAt DateTime          @default(now())
  createdBy String?

  @@index([productId])
  @@index([createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String?
  referrer  String?
  device    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

// Simple key/value settings (alert toggles, business profile).
// Alert keys: alert_new_order, alert_low_stock, alert_daily_summary, alert_returns ("1"/"0")
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Customer product reviews. Submitted from the track-order page after an
// order is delivered; shown on the product page's reviews section.
model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId    String?
  customerName String
  rating     Int      // 1..5
  title      String?
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([isApproved])
}
