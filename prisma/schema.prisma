// Zulfira dynamic platform — Postgres schema (Neon).
// Money is ALWAYS Decimal(12,2). Never float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum ExpenseCategory {
  RAW_MATERIAL
  PACKAGING
  DELIVERY
  MARKETING
  SALARY
  UTILITIES
  OTHER
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  WASTE
}

enum AdminRole {
  OWNER
  STAFF
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  sku           String?  @unique
  tagline       String?
  size          String?
  salePrice     Decimal  @db.Decimal(12, 2)
  compareAt     Decimal? @db.Decimal(12, 2)
  unitCost      Decimal  @default(0) @db.Decimal(12, 2)
  stockQty      Int      @default(0)
  lowStockLevel Int      @default(10)
  image         String?
  gallery       String[] @default([])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  investors   ProductInvestor[]
  investments Investment[]
  expenses    Expense[]
  orderItems  OrderItem[]
  movements   StockMovement[]
  reviews     Review[]
  subscriptions Subscription[]
}

model Investor {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  productLinks ProductInvestor[]
  investments  Investment[]
}

// Profit-share agreement: one row per (product, investor).
// profitSharePct across all investors of a product MUST total 100.
model ProductInvestor {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  investorId    String
  investor      Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  profitSharePct Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@unique([productId, investorId])
  @@index([productId])
}

// Money put in, per tranche (history preserved).
model Investment {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  investedAt DateTime @default(now())
  notes      String?

  @@index([productId])
  @@index([investorId])
}

// productId = null  =>  general expense (allocated across products by revenue share).
model Expense {
  id        String          @id @default(cuid())
  category  ExpenseCategory
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  amount    Decimal         @db.Decimal(12, 2)
  date      DateTime        @default(now())
  note      String?
  receiptUrl String?
  createdBy String?
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([category])
  @@index([date])
}

model Order {
  id             String        @id @default(cuid())
  orderNo        String        @unique
  customerName   String
  email          String?
  phone          String
  address        String
  city           String
  notes          String?
  status         OrderStatus   @default(PENDING)
  statusReason   String?
  payment        PaymentMethod @default(COD)
  subtotal       Decimal       @db.Decimal(12, 2)
  deliveryCharge Decimal       @default(0) @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deliveredAt    DateTime?
  courierName    String?
  trackingNumber String?

  items OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([phone])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty       Int
  unitPrice Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  qty       Int // positive = stock in, negative = stock out
  note      String?
  orderId   String?
  createdAt DateTime          @default(now())
  createdBy String?

  @@index([productId])
  @@index([createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String?
  referrer  String?
  device    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

// Simple key/value settings (alert toggles, business profile).
// Alert keys: alert_new_order, alert_low_stock, alert_daily_summary, alert_returns ("1"/"0")
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Customer product reviews. Submitted from the track-order page after an
// order is delivered; shown on the product page's reviews section.
model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId    String?
  customerName String
  rating     Int      // 1..5
  title      String?
  comment    String
  videoUrl   String? // optional video testimonial URL (TikTok/Instagram/YouTube)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([isApproved])
}

// ── Loyalty & growth programs ──────────────────────────────────────
// Master switches + per-program config. Admin enables a program here;
// all program logic checks its flag before running.
model LoyaltyProgram {
  id        String   @id @default(cuid())
  key       String   @unique // reorder_reminders | subscribe_save | review_rewards | inbox_upsell | challenge_30 | gift_trial | insiders
  name      String
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// Discount codes issued by loyalty programs (also usable manually).
model DiscountCode {
  id         String    @id @default(cuid())
  code       String    @unique
  kind       String    // 'percent' | 'fixed'
  value      Decimal   @db.Decimal(12, 2)
  minOrder   Decimal?  @db.Decimal(12, 2)
  maxUses    Int?
  usedCount  Int       @default(0)
  programKey String?   // loyalty program that issued it
  phone      String?   // locked to one customer phone (personal codes)
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([code])
  @@index([programKey])
}

// Subscribe & Save recurring orders.
model Subscription {
  id           String   @id @default(cuid())
  customerName String
  phone        String
  address      String
  city         String
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  intervalDays Int      @default(45)
  nextShipDate DateTime
  status       String   @default("active") // active | paused | cancelled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([nextShipDate])
}

// 30-day hair challenge.
model ChallengeRound {
  id             String   @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  maxChallengers Int      @default(200)
  status         String   @default("open") // open | running | ended
  createdAt      DateTime @default(now())
  challengers    Challenger[]
}

model Challenger {
  id        String   @id @default(cuid())
  roundId   String
  round     ChallengeRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  handle    String
  orderNo   String?
  strikes   Int      @default(0)
  status    String   @default("active") // active | out | completed
  joinedAt  DateTime @default(now())
  checkins  ChallengeCheckin[]

  @@index([roundId])
  @@index([phone])
}

model ChallengeCheckin {
  id           String   @id @default(cuid())
  challengerId String
  challenger   Challenger @relation(fields: [challengerId], references: [id], onDelete: Cascade)
  day          Int
  postUrl      String
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([challengerId, day])
}

// Gift-a-trial-bottle.
model GiftTrial {
  id            String   @id @default(cuid())
  senderName    String
  senderPhone   String
  senderEmail   String?
  friendName    String
  friendPhone   String
  friendEmail   String?
  friendAddress String
  friendCity    String
  status        String   @default("pending") // pending | shipped | delivered | ordered
  creditIssued  Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([senderPhone])
  @@index([friendPhone])
}

// Wallet credits earned (referral rewards, gift-trial sender rewards).
model WalletCredit {
  id        String   @id @default(cuid())
  phone     String
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  code      String?  // discount code issued for this credit
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

// 1% equity (profit-share) program — 1-year term.
model EquityOwner {
  id         String    @id @default(cuid())
  name       String
  phone      String
  email      String?
  cnic       String?
  slots      Int       @default(1) // number of 1% slots
  amountPaid Decimal   @db.Decimal(12, 2)
  status     String    @default("applied") // applied | approved | active | ended
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  payouts    EquityPayout[]

  @@index([phone])
  @@index([status])
}

model EquityPayout {
  id        String      @id @default(cuid())
  ownerId   String
  owner     EquityOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  quarter   String      // e.g. "2026-Q3"
  profit    Decimal     @db.Decimal(12, 2)
  payout    Decimal     @db.Decimal(12, 2)
  paidAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([ownerId])
}

// Log of every email send attempt.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String?
  status    String   // sent | skipped | failed
  error     String?
  createdAt DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}

// Marketing email opt-outs.
model EmailPreference {
  email        String   @id
  unsubscribed Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
