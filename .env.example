# Copy to .env.local (local dev) or set in Vercel → Project → Settings → Environment Variables.

# Neon Postgres connection string (required for DB features; app builds & runs without it)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/zulfira?sslmode=require"

# Secret for signing admin session JWTs (required for /admin login). Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Telegram alerts (optional — alerts silently skip when absent)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Vercel Cron protection (optional — set to require a secret on /api/cron/*)
CRON_SECRET=""
